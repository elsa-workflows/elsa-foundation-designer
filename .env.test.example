# Copy to .env.test.local and fill in real values.
# Playwright reads this file via dotenv in playwright.config.ts.

# Base URL the suite drives. Defaults to http://localhost:3000 when unset.
E2E_BASE_URL=http://localhost:3000

# Credentials Playwright uses for the one-time login in e2e/auth.setup.ts.
# Must be valid against the Elsa identity backend the app is pointed at.
E2E_USERNAME=
E2E_PASSWORD=

# The dev server (booted by Playwright's webServer config) reads these from
# its own .env.local; they're documented here for convenience. The webServer
# inherits the parent shell's env, so if .env.local isn't sufficient, export
# these before running `pnpm test:e2e`.
# ELSA_API_URL=http://localhost:5072/elsa/api
# NEXT_PUBLIC_ELSA_API_URL=http://localhost:5072/elsa/api
