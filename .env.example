# Elsa Workflow Server base URL — single-engine fallback.
# - ELSA_API_URL: used by Next.js Route Handlers (server-only) for the auth proxy.
# - NEXT_PUBLIC_ELSA_API_URL: used by the browser-side TanStack Query hooks.
# They normally point at the same backend; split so server-side calls can use an
# internal address (e.g. docker hostname) when deployed.
ELSA_API_URL=https://localhost:5001/elsa/api
NEXT_PUBLIC_ELSA_API_URL=https://localhost:5001/elsa/api

# Multi-engine setup. When present these override the single-URL vars above
# and let users switch between engines from the sidebar dropdown. JSON array
# of { id, label, url }. The two lists MUST mirror each other — the server
# allowlist (ELSA_ENGINES) is the only thing the auth proxy will forward
# credentials to, so engines not in the server list cannot log in.
# NEXT_PUBLIC_ELSA_ENGINES=[{"id":"local","label":"Local","url":"https://localhost:5001/elsa/api"},{"id":"staging","label":"Staging","url":"https://elsa-staging.example.com/elsa/api"}]
# ELSA_ENGINES=[{"id":"local","label":"Local","url":"https://localhost:5001/elsa/api"},{"id":"staging","label":"Staging","url":"https://elsa-staging.example.com/elsa/api"}]

# Used to sign / verify any internal session payloads (reserved for future use).
# Generate with: `openssl rand -base64 32`
SESSION_SECRET=change-me-in-local-dev-only

# When developing against an Elsa server with a self-signed cert, point Node at
# the cert so route-handler fetches don't fail TLS validation.
# NODE_EXTRA_CA_CERTS=/path/to/elsa-dev.crt
